<ui:FluentWindow x:Class="PdfManager.App.DocumentPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="文書の選択"
                 Width="640" Height="680" MinWidth="460" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="文書の選択" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="20,0,20,8">
            <ui:TextBlock x:Name="GuideText" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ui:TextBox x:Name="SearchBox" PlaceholderText="タイトル・ファイル名・タグで検索" Icon="{ui:SymbolIcon Search24}"
                        TextChanged="OnSearchChanged" AutomationProperties.Name="文書の検索" />
        </StackPanel>
        <ListBox x:Name="CandidateList" Grid.Row="2" Margin="20,0,20,0" MouseDoubleClick="OnDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="選べる文書"
                 VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{Binding Sub}" FontSize="12" TextTrimming="CharacterEllipsis"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="3" Margin="20,12,20,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="キャンセル" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" />
                <ui:Button Content="選ぶ" Appearance="Primary" Click="OnOkClick" AutomationProperties.Name="選ぶ" />
            </StackPanel>
            <ui:TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
