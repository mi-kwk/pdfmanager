<ui:FluentWindow x:Class="PdfManager.App.TagGapWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:PdfManager.App.ViewModels"
                 xmlns:conv="clr-namespace:PdfManager.App.Converters"
                 xmlns:views="clr-namespace:PdfManager.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:TagGapViewModel}"
                 Title="タグの付け漏れ確認"
                 Width="1320" Height="860" MinWidth="1000" MinHeight="620"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="Hint" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ConditionLabel" TargetType="ui:TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="タグの付け漏れ確認" ShowMinimize="False" />

        <!-- 上部:探す条件(決定ログ BC-2〜BC-5)。「探すもの」は件数付きのボタン -->
        <Border Grid.Row="1" Style="{StaticResource PaneBorder}" Margin="16,0,16,12" Padding="12,8">
            <WrapPanel>
                <ItemsControl ItemsSource="{Binding Kinds}" AutomationProperties.Name="探すもの">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="TagGapKind" Style="{StaticResource {x:Type ToggleButton}}" Margin="0,4,6,4" Padding="10,5"
                                         Content="{Binding Text}" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4" Visibility="{Binding ShowGroupChoice, Converter={StaticResource BoolToVisibility}}">
                    <ui:TextBlock Text="グループ" Style="{StaticResource ConditionLabel}" />
                    <ComboBox ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding SelectedGroup}" MinWidth="170" AutomationProperties.Name="グループ" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4" Visibility="{Binding ShowRankChoice, Converter={StaticResource BoolToVisibility}}">
                    <ui:TextBlock Text="順位" Style="{StaticResource ConditionLabel}" />
                    <ComboBox ItemsSource="{Binding RankChoices}" SelectedItem="{Binding SelectedRank}" MinWidth="150" AutomationProperties.Name="順位" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <ui:TextBlock Text="{Binding FilterLabel}" Style="{StaticResource ConditionLabel}" />
                    <ComboBox ItemsSource="{Binding FilterChoices}" SelectedItem="{Binding SelectedFilter}" MinWidth="170" AutomationProperties.Name="絞り込みのタグ" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <ui:TextBlock Text="キーワード" Style="{StaticResource ConditionLabel}" />
                    <ui:TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="180" PlaceholderText="タイトル・ファイル名"
                                AutomationProperties.Name="キーワード" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <ui:TextBlock Text="対象" Style="{StaticResource ConditionLabel}" />
                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" MinWidth="200" AutomationProperties.Name="対象" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="460" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- 左:見つかった PDF(決定ログ BC-6) -->
            <Border Grid.Column="0" Style="{StaticResource PaneBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ui:TextBlock DockPanel.Dock="Right" Text="{Binding ResultText}" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ResultCount" />
                        <ui:TextBlock Text="見つかった PDF" FontTypography="BodyStrong" />
                    </DockPanel>
                    <ListBox x:Name="RowList" ItemsSource="{Binding Rows}" SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="見つかった PDF"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <ui:TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <ui:TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <ui:TextBlock Text="{Binding TagsText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBlock Text="{Binding StorageText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StorageText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 中央:1 ページ目のプレビュー -->
            <Border Grid.Column="2" Style="{StaticResource PaneBorder}">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
            </Border>

            <!-- 右:入力欄(取り込み画面と同じ) -->
            <Border Grid.Column="4" Style="{StaticResource PaneBorder}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <ui:TextBlock Text="{Binding SelectionText}" FontTypography="BodyStrong" TextWrapping="Wrap" />
                        <ui:InfoBar Margin="0,8,0,0" IsClosable="False" Severity="Warning" Title="表示のみ" Message="{Binding ReadOnlyMessage}"
                                    IsOpen="{Binding IsReadOnly, Mode=OneWay}" />
                        <views:DocumentEditorView DataContext="{Binding Editor}"
                                                  Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 下部 -->
        <DockPanel Grid.Row="3" Margin="16,12,16,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <ui:Button Content="閉じる" Click="OnCloseClick" Margin="0,0,8,0" />
                <ui:Button Content="選択中を保存" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}"
                           AutomationProperties.Name="選択中を保存" ToolTip="左の一覧で選んでいる PDF を保存し、次の PDF を選びます" />
            </StackPanel>
            <ui:TextBlock Text="{Binding SaveMessage}" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                          AutomationProperties.AutomationId="SaveMessage" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
