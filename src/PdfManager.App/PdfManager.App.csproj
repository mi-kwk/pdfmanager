<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>PdfManager</AssemblyName>
    <RootNamespace>PdfManager.App</RootNamespace>
    <!-- アプリのバージョン(2026-11-10 の利用者の要望)。exe を作った日時から自動で付ける:年.月.日.時分(例 2026.11.10.1829) -->
    <Version>$([System.DateTime]::Now.ToString("yyyy.M.d.HHmm"))</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfManager.Core\PdfManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
