<ui:FluentWindow x:Class="PdfManager.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="設定"
                 Width="900" Height="860" MinWidth="720" MinHeight="620"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="設定" ShowMinimize="False" ShowMaximize="False" />

        <!-- 画面に収まらないときはスクロールする(大きいときは、サブライブラリと最近使ったライブラリの欄が広がる) -->
        <ScrollViewer Grid.Row="1" x:Name="ContentScroll" Margin="16,0,16,16" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="940" Height="{Binding ViewportHeight, ElementName=ContentScroll}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="200" />
                <RowDefinition Height="2*" MinHeight="140" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PaneBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="現在のライブラリ(メイン)" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock x:Name="CurrentName" FontTypography="Subtitle" />
                    <ui:TextBlock x:Name="CurrentFolder" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    <ui:TextBlock x:Name="CurrentStats" Text="集計中…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,12" />
                    <WrapPanel>
                        <ui:Button Content="新しいライブラリを作る" Icon="{ui:SymbolIcon FolderAdd24}" Click="OnCreateClick" Margin="0,0,8,8" />
                        <ui:Button Content="ライブラリを開く" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenClick" Margin="0,0,8,8" />
                        <ui:Button Content="エクスプローラーで開く" Icon="{ui:SymbolIcon Open24}" Click="OnExplorerClick" Margin="0,0,8,8" />
                    </WrapPanel>
                    <ui:TextBlock Text="他の人に渡すときは「PdfManager」フォルダごとコピーしてください。ライブラリを切り替えると、メイン画面が開き直されます。"
                                  TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- サブライブラリ(決定ログ S-1、S-5、S-8、S-15) -->
            <Border Grid.Row="1" Style="{StaticResource PaneBorder}" Margin="0,0,0,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="接続を確認" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Transparent"
                                   Click="OnCheckSubsClick" ToolTip="外付け HDD などをつないだあとに、サブライブラリを探し直します" />
                        <ui:TextBlock Text="サブライブラリ" FontTypography="BodyStrong" VerticalAlignment="Center" />
                    </DockPanel>
                    <ui:TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="見る回数の少ない PDF や過去の PDF を、別のドライブや外付け HDD に置く場所です。一覧の右クリック「保存先を移す」で移します。つながっていないサブの PDF も一覧・検索には出ますが、表示のみになります。" />
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <ui:Button Content="新しいサブを作る" Appearance="Primary" Icon="{ui:SymbolIcon FolderAdd24}" Click="OnCreateSubClick" Margin="0,0,8,8" />
                        <ui:Button Content="名前の変更" Icon="{ui:SymbolIcon Edit24}" Click="OnRenameSubClick" Margin="0,0,8,8" />
                        <ui:Button Content="場所を指定し直す" Icon="{ui:SymbolIcon Search24}" Click="OnRelocateSubClick" Margin="0,0,8,8"
                                   ToolTip="サブライブラリのフォルダを移した・2 か所で見つかったときに、使う .pdflib ファイルを選びます" />
                        <ui:Button Content="エクスプローラーで開く" Icon="{ui:SymbolIcon Open24}" Click="OnExplorerSubClick" Margin="0,0,8,8"
                                   AutomationProperties.Name="サブをエクスプローラーで開く" />
                        <ui:Button Content="登録の解除" Icon="{ui:SymbolIcon Dismiss24}" Click="OnRemoveSubClick" Margin="0,0,8,8"
                                   ToolTip="中の PDF が 0 件のときだけ解除できます(フォルダは消しません)" />
                    </WrapPanel>
                    <Grid>
                        <ui:TextBlock x:Name="NoSubsText" Text="サブライブラリはまだありません。「新しいサブを作る」で作れます。" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4" />
                        <ListBox x:Name="SubList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="サブライブラリの一覧">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <!-- 選択中の行の色に埋もれないよう、色付きの札にする -->
                                        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF0F7B0F" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                            <Setter Property="Background" Value="#FFC4511A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" />
                                        </Border>
                                        <StackPanel>
                                            <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" />
                                            <ui:TextBlock Text="{Binding Folder}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="{Binding Usage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                                          Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                          Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PaneBorder}">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Top" Text="最近使ったライブラリ" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button Content="一覧から削除" Icon="{ui:SymbolIcon Dismiss24}" Click="OnForgetClick" Margin="0,0,8,0" />
                        <ui:Button Content="開く" Appearance="Primary" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenRecentClick"
                                   AutomationProperties.Name="選んだライブラリを開く" />
                    </StackPanel>
                    <ListBox x:Name="RecentList" MouseDoubleClick="OnOpenRecentClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <ui:TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Margin="12,0,0,0"
                                                  Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" />
                                        <ui:TextBlock Text="{Binding Folder}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- この PC での設定:取り込み画面(決定ログ R-5、AA-1)とバックアップ(決定ログ BB-1〜BB-7) -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PaneBorder}">
                <StackPanel>
                    <ui:TextBlock Text="取り込み画面(この PC の設定)" FontTypography="BodyStrong" Margin="0,0,0,4" />
                    <CheckBox x:Name="ShowRegisterAllBox" Content="「すべて登録」ボタンも表示する"
                              Checked="OnShowRegisterAllChanged" Unchecked="OnShowRegisterAllChanged"
                              AutomationProperties.Name="「すべて登録」ボタンも表示する" />
                    <ui:TextBlock Text="オフのときは「選択中を登録」だけを表示します(1 件ずつ入力して登録する使い方)。"
                                  TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <!-- 決定ログ AA-1: タグを選ぶと、その欄を畳んで次の順位の欄をすぐ選べるようにする -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:TextBlock Text="タグを選んだら畳む欄" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="TagCollapseRankBox" MinWidth="180" SelectionChanged="OnTagCollapseRankChanged"
                                  AutomationProperties.Name="タグを選んだら畳む欄">
                            <ComboBoxItem Content="畳まない" />
                            <ComboBoxItem Content="順位 1 だけ" />
                            <ComboBoxItem Content="順位 1〜2" />
                            <ComboBoxItem Content="順位 1〜3" />
                            <ComboBoxItem Content="順位 1〜4" />
                        </ComboBox>
                    </StackPanel>
                    <ui:TextBlock Text="取り込み画面とタグ設定画面で、タグにチェックを付けるとその欄を 1 行に畳み、次の順位の欄をすぐ選べるようにします。畳んだ欄は押すと開き直せます。"
                                  TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PaneBorder}">
                <StackPanel>
                    <ui:TextBlock Text="バックアップ(この PC の設定)" FontTypography="BodyStrong" Margin="0,0,0,4" />
                    <ui:TextBlock x:Name="BackupFolderText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  AutomationProperties.AutomationId="BackupFolder" />
                    <ui:TextBlock x:Name="BackupLastText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Margin="0,2,0,8" AutomationProperties.AutomationId="BackupLast" />
                    <WrapPanel>
                        <ui:Button Content="今すぐバックアップ" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="OnBackupClick" Margin="0,0,8,8"
                                   AutomationProperties.Name="今すぐバックアップ" />
                        <ui:Button Content="保存先を選ぶ" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnChooseBackupFolderClick" Margin="0,0,8,8"
                                   AutomationProperties.Name="バックアップの保存先を選ぶ" />
                        <ui:Button Content="バックアップから戻す" Icon="{ui:SymbolIcon ArrowUndo24}" Click="OnRestoreClick" Margin="0,0,8,8"
                                   AutomationProperties.Name="バックアップから戻す" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:TextBlock Text="古い回を残す数" VerticalAlignment="Center" Margin="0,0,8,0" Width="110" />
                        <ui:NumberBox x:Name="KeepOldBox" Minimum="0" Maximum="30" SmallChange="1" MaxDecimalPlaces="0" Width="140"
                                      ValueChanged="OnKeepOldChanged" AutomationProperties.Name="古い回を残す数" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:TextBlock Text="起動時に知らせる" VerticalAlignment="Center" Margin="0,0,8,0" Width="110" />
                        <ComboBox x:Name="ReminderBox" MinWidth="140" SelectionChanged="OnReminderChanged" AutomationProperties.Name="起動時に知らせる">
                            <ComboBoxItem Content="知らせない" Tag="0" />
                            <ComboBoxItem Content="3 日たったら" Tag="3" />
                            <ComboBoxItem Content="7 日たったら" Tag="7" />
                            <ComboBoxItem Content="14 日たったら" Tag="14" />
                            <ComboBoxItem Content="30 日たったら" Tag="30" />
                        </ComboBox>
                    </StackPanel>
                    <ui:TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="2 回目からは増えた PDF だけをコピーします。文書の情報は、最新の回に加えて「古い回を残す数」だけ残します(0 なら最新の 1 回分だけ)。どの回にも載っていない PDF はバックアップから消します(ライブラリの PDF には触りません)。" />
                </StackPanel>
            </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
