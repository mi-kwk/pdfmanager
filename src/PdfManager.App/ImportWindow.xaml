<ui:FluentWindow x:Class="PdfManager.App.ImportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:PdfManager.App.ViewModels"
                 xmlns:conv="clr-namespace:PdfManager.App.Converters"
                 xmlns:views="clr-namespace:PdfManager.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ImportViewModel}"
                 Title="取り込み"
                 Width="1320" Height="860" MinWidth="1000" MinHeight="620"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 PreviewDragOver="OnDragOver"
                 PreviewDrop="OnDrop">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="Hint" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="取り込み" ShowMinimize="False" />

        <!-- 上部 -->
        <StackPanel Grid.Row="1" Margin="16,0,16,12">
            <!-- 新しい版として登録するとき(決定ログ N-1①) -->
            <ui:InfoBar Margin="0,0,0,8" IsClosable="False" Severity="Informational" Title="新しい版"
                        Message="{Binding NewVersionText}" IsOpen="{Binding IsNewVersionMode, Mode=OneWay}" />
            <DockPanel>
                <ui:Button DockPanel.Dock="Left" Content="ファイルを追加" Icon="{ui:SymbolIcon DocumentAdd24}"
                           Command="{Binding SelectFilesToAddCommand}" />
                <ui:TextBlock DockPanel.Dock="Left" Text="ファイルやフォルダをこの画面にドラッグ&amp;ドロップしても追加できます"
                              Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="{Binding DeleteOriginals}"
                          Content="登録後に元のファイルをごみ箱へ移動" AutomationProperties.Name="登録後に元のファイルをごみ箱へ移動" />
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="460" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- 左:取り込み待ちの一覧 -->
            <Border Grid.Column="0" Style="{StaticResource PaneBorder}">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Top" Text="{Binding ListHeader}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:Button DockPanel.Dock="Bottom" Content="一覧から外す" Icon="{ui:SymbolIcon Dismiss24}" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch" Command="{Binding RemoveSelectedCommand}" />
                    <ListBox x:Name="ItemList" ItemsSource="{Binding Items}" SelectionMode="Extended"
                             SelectedItem="{Binding PrimarySelection}" SelectionChanged="OnSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="取り込み待ち">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Border DockPanel.Dock="Left" Width="40" Height="52" Margin="0,0,10,0" CornerRadius="3"
                                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="White">
                                        <Image Source="{Binding Preview}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <ui:TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 中央:1 ページ目のプレビュー(決定ログ F-4) -->
            <Border Grid.Column="2" Style="{StaticResource PaneBorder}">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewMessage}" Style="{StaticResource Hint}"
                                  HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                </DockPanel>
            </Border>

            <!-- 右:入力欄 -->
            <Border Grid.Column="4" Style="{StaticResource PaneBorder}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <ui:TextBlock Text="{Binding SelectionText}" FontTypography="BodyStrong" TextWrapping="Wrap" />

                        <views:DocumentEditorView DataContext="{Binding Editor}" />
                        <ui:Button Content="前回と同じ" Icon="{ui:SymbolIcon ArrowRepeatAll24}" Margin="0,16,0,0"
                                   Command="{Binding ApplyLastInputCommand}" IsEnabled="{Binding HasEditableSelection}"
                                   ToolTip="前回登録したときの項目・タグ・ファイル名の先頭を入れます" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 下部 -->
        <DockPanel Grid.Row="3" Margin="16,12,16,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <ui:Button Content="閉じる" Click="OnCloseClick" Margin="0,0,8,0" />
                <ui:Button Content="{Binding RegisterText}" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                           Command="{Binding RegisterCommand}" AutomationProperties.Name="登録" />
            </StackPanel>
            <ui:InfoBar IsOpen="{Binding IsResultOpen, Mode=TwoWay}" IsClosable="True"
                        Title="{Binding ResultTitle}" Message="{Binding ResultMessage}" Severity="{Binding ResultSeverity}" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
