<ui:FluentWindow x:Class="PdfManager.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:PdfManager.App.ViewModels"
                 xmlns:conv="clr-namespace:PdfManager.App.Converters"
                 xmlns:views="clr-namespace:PdfManager.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="PdfManager"
                 Width="1400" Height="860" MinWidth="960" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 PreviewDragOver="OnDragOver"
                 PreviewDrop="OnDrop">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ThumbnailConverter x:Key="Thumbnail" DecodeWidth="240" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="InfoLabel" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>

        <!-- サムネイル 1 枚分。選択中は枠に色を付けて強調する(決定ログ G-5) -->
        <Style x:Key="ThumbnailItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" CornerRadius="8" BorderThickness="3" BorderBrush="Transparent"
                                Background="Transparent" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <Style x:Key="ListHeader" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- 絞り込みのタグ 1 つ分(決定ログ L-1・L-3)。項目の欄と「タグを検索」の欄で使う -->
        <DataTemplate x:Key="TagFilterTemplate">
            <DockPanel Margin="0,1" Background="Transparent">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding ExcludeMenuText}" Command="{Binding ToggleExcludeCommand}" />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZero}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <ui:TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Margin="8,0,0,0"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock DockPanel.Dock="Right" Text="✕ 除外" Margin="8,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                              Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Tag.Name}">
                    <StackPanel>
                        <ui:TextBlock Text="{Binding Tag.Name}" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{Binding Tag.DetailText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </CheckBox>
            </DockPanel>
        </DataTemplate>
        <!-- 項目の欄では、グループ名は見出しにあるので、2 行目は紐づけ先だけ -->
        <DataTemplate x:Key="PinnedTagFilterTemplate">
            <DockPanel Margin="0,1" Background="Transparent">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding ExcludeMenuText}" Command="{Binding ToggleExcludeCommand}" />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZero}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <ui:TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Margin="8,0,0,0"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock DockPanel.Dock="Right" Text="✕ 除外" Margin="8,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                              Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Tag.Name}">
                    <StackPanel>
                        <ui:TextBlock Text="{Binding Tag.Name}" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{Binding Tag.ParentText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Visibility="{Binding Tag.HasParents, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </CheckBox>
            </DockPanel>
        </DataTemplate>
        <!-- 補助項目の値 1 つ分(決定ログ Q-6) -->
        <DataTemplate x:Key="OptionFilterTemplate">
            <DockPanel Margin="0,1">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZero}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <ui:TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Value}" />
            </DockPanel>
        </DataTemplate>

        <!-- 続き・関連の 1 行(決定ログ V-1)。開く・選択・外す -->
        <DataTemplate x:Key="ChainRowTemplate">
            <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Icon="{ui:SymbolIcon Open24}" Padding="6,4" Margin="0,0,4,0" ToolTip="開く" Tag="{Binding Id}" Click="OnOpenLinkClick"
                                   AutomationProperties.Name="{Binding Document.Title, StringFormat={}{0}を開く}" />
                        <ui:Button Icon="{ui:SymbolIcon CursorClick24}" Padding="6,4" Margin="0,0,4,0" ToolTip="選択" Tag="{Binding Id}" Click="OnSelectLinkClick"
                                   AutomationProperties.Name="{Binding Document.Title, StringFormat={}{0}を選択}" />
                        <ui:Button Icon="{ui:SymbolIcon LinkDismiss24}" Padding="6,4" ToolTip="続きから外す" Tag="{Binding Id}" Click="OnRemoveChainClick"
                                   AutomationProperties.Name="{Binding Document.Title, StringFormat={}{0}を続きから外す}" />
                    </StackPanel>
                    <StackPanel>
                        <ui:TextBlock Text="{Binding Text}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{Binding Sub}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RelatedRowTemplate">
            <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Icon="{ui:SymbolIcon Open24}" Padding="6,4" Margin="0,0,4,0" ToolTip="開く" Tag="{Binding Id}" Click="OnOpenLinkClick"
                                   AutomationProperties.Name="{Binding Document.Title, StringFormat={}{0}を開く}" />
                        <ui:Button Icon="{ui:SymbolIcon CursorClick24}" Padding="6,4" Margin="0,0,4,0" ToolTip="選択" Tag="{Binding Id}" Click="OnSelectLinkClick"
                                   AutomationProperties.Name="{Binding Document.Title, StringFormat={}{0}を選択}" />
                        <ui:Button Icon="{ui:SymbolIcon LinkDismiss24}" Padding="6,4" ToolTip="関連から外す" Tag="{Binding Id}" Click="OnRemoveRelatedClick"
                                   AutomationProperties.Name="{Binding Document.Title, StringFormat={}{0}を関連から外す}" />
                    </StackPanel>
                    <StackPanel>
                        <ui:TextBlock Text="{Binding Text}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{Binding Sub}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 保存先の印。つながっていないときは注意の色(決定ログ S-4) -->
        <Style x:Key="StorageBadge" TargetType="Border">
            <Setter Property="Background" Value="#FF6B6B6B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Background" Value="#FFC4511A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- サムネイル表示(決定ログ G-5) -->
        <ItemsPanelTemplate x:Key="GridPanel">
            <ui:VirtualizingWrapPanel ItemSize="188,306" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="CardTemplate">
            <StackPanel Width="156">
                <Border Height="200" CornerRadius="4" BorderThickness="1" Background="White"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="40" Foreground="#99999999" />
                        <Image Source="{Binding ThumbnailPath, Converter={StaticResource Thumbnail}}" Stretch="Uniform" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" Padding="6,1" CornerRadius="4"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding HasVersion, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding VersionText}" Foreground="White" FontSize="11" />
                        </Border>
                        <!-- 続きの位置(決定ログ V-4) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="6,1" CornerRadius="4"
                                Background="#FF5B5FC7" Visibility="{Binding HasChain, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ChainText}" Foreground="White" FontSize="11" />
                        </Border>
                        <!-- サブにある文書の保存先と、つながっていない印(決定ログ S-4) -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" Padding="6,1" CornerRadius="4"
                                Style="{StaticResource StorageBadge}" Visibility="{Binding HasStorage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding StorageText}" Foreground="White" FontSize="11" />
                        </Border>
                    </Grid>
                </Border>
                <ui:TextBlock Text="{Binding Title}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="38"
                              TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <ui:TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding FileName}" />
            </StackPanel>
        </DataTemplate>

        <!-- リスト表示(決定ログ L-9)。列幅は見出しと同じ -->
        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                            Style="{StaticResource StorageBadge}" Visibility="{Binding HasStorage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding StorageText}" Foreground="White" FontSize="11" />
                    </Border>
                    <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Visibility="{Binding HasVersion, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding VersionText}" Foreground="White" FontSize="11" />
                    </Border>
                    <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                            Background="#FF5B5FC7" Visibility="{Binding HasChain, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ChainText}" Foreground="White" FontSize="11" />
                    </Border>
                    <ui:TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                </DockPanel>
                <ui:TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Margin="0,0,8,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock Grid.Column="2" Text="{Binding TagText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TagText}" Margin="0,0,8,0" />
                <ui:TextBlock Grid.Column="3" Text="{Binding RatingText}" Foreground="#F5A623" Margin="0,0,8,0" />
                <ui:TextBlock Grid.Column="4" Text="{Binding RegisteredText}" Margin="0,0,8,0" />
                <ui:TextBlock Grid.Column="5" Text="{Binding ViewCountText}" Margin="0,0,8,0" />
                <ui:TextBlock Grid.Column="6" Text="{Binding LastViewedText}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" BorderThickness="3,0,0,1" Padding="9,8,8,8" Background="Transparent"
                                BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DocumentListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="ItemsPanel" Value="{StaticResource GridPanel}" />
            <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThumbnailItem}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListView}" Value="True">
                    <Setter Property="ItemsPanel" Value="{StaticResource ListPanel}" />
                    <Setter Property="ItemTemplate" Value="{StaticResource RowTemplate}" />
                    <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="PdfManager" />

        <!-- 下部:サブライブラリの接続状況(決定ログ S-1)。押すと設定画面を開く -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,0,16,8"
                    Visibility="{Binding HasSubs, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Appearance="Transparent" Padding="8,2" Icon="{ui:SymbolIcon HardDrive20}" Content="{Binding SubStatusText}"
                       Click="OnSubStatusClick" ToolTip="サブライブラリの接続状況(押すと設定画面を開きます)"
                       AutomationProperties.AutomationId="SubStatus" />
        </StackPanel>

        <!-- ツールバー -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,4,16,12">
            <ui:Button Content="取り込み"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon DocumentAdd24}"
                       Click="OnImportClick"
                       ToolTip="PDF を選んで取り込みます(ファイルやフォルダを画面にドラッグ&amp;ドロップしても取り込めます)"
                       Margin="0,0,8,0" />
            <ui:Button Content="項目・タグ"
                       Icon="{ui:SymbolIcon Tag24}"
                       Click="OnManageCatalogClick"
                       ToolTip="検索に使う項目と自由タグを管理します"
                       Margin="0,0,8,0" />
            <ui:Button Icon="{ui:SymbolIcon Settings24}" Click="OnSettingsClick" ToolTip="設定(ライブラリの切り替えなど)"
                       AutomationProperties.Name="設定" />
        </StackPanel>

        <!-- 3 分割:絞り込み / 一覧 / 詳細 -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="320" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- 左:絞り込み -->
            <Border Grid.Column="0" Style="{StaticResource PaneBorder}" Padding="16,16,4,16">
                <!-- 横にはみ出さないよう、幅に合わせて折り返す。右側はスクロールバーと重ならないよう空ける -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,0">
                        <DockPanel Margin="0,0,0,8">
                            <ui:Button DockPanel.Dock="Right" Content="条件をクリア" Appearance="Transparent" Padding="6,2"
                                       Command="{Binding ClearConditionsCommand}" />
                            <ui:TextBlock Text="絞り込み" FontTypography="BodyStrong" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- 保存した検索(F-16、決定ログ X-3)。初めは閉じておく -->
                        <Expander Header="保存した検索" Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBlock Text="まだありません。条件を指定して「今の条件を保存」を押すと、ここから呼び出せます。" Style="{StaticResource SecondaryText}" FontSize="12"
                                              Margin="0,0,0,6" Visibility="{Binding HasSavedSearches, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding SavedSearches}" AutomationProperties.Name="保存した検索の一覧">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="{Binding Name}" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                       Padding="8,4" Margin="0,0,0,2" Click="OnApplySavedSearchClick" ToolTip="この条件で絞り込みます(右クリックで名前の変更・並び替え・削除)"
                                                       AutomationProperties.Name="{Binding Name, StringFormat={}保存した検索 {0}}">
                                                <ui:Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="名前の変更" Click="OnRenameSavedSearchClick" />
                                                        <MenuItem Header="上へ" Click="OnMoveSavedSearchUpClick" />
                                                        <MenuItem Header="下へ" Click="OnMoveSavedSearchDownClick" />
                                                        <MenuItem Header="削除" Click="OnDeleteSavedSearchClick" />
                                                    </ContextMenu>
                                                </ui:Button.ContextMenu>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Content="今の条件を保存" Icon="{ui:SymbolIcon Save24}" Margin="0,6,0,0" Click="OnSaveSearchClick"
                                           AutomationProperties.Name="今の条件を保存" />
                            </StackPanel>
                        </Expander>

                        <!-- フリー検索(決定ログ I-1〜I-5) -->
                        <ui:TextBox x:Name="SearchBox" PlaceholderText="キーワードで検索(Ctrl+F)" Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="キーワード検索" />
                        <ui:TextBlock Text="タイトル・タグ・ファイル名・項目の値から探します。ひらがな・カタカナ、全角・半角は区別しません。スペースで区切ると、すべてを含むものを探します。"
                                      Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,8" />
                        <CheckBox Content="旧版も表示する" IsChecked="{Binding IncludeOldVersions}" Margin="0,0,0,12"
                                  ToolTip="版のある PDF は、ふだんは最新版だけを表示します" AutomationProperties.Name="旧版も表示する" />

                        <!-- タグ(決定ログ L-1)。チェック=含む、右クリック=除外 -->
                        <ui:TextBlock Text="タグ" FontTypography="BodyStrong" Margin="0,4,0,4" />
                        <ui:TextBlock Text="タグはまだありません" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"
                                      Visibility="{Binding HasTags, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                            <WrapPanel Margin="0,0,0,4">
                                <RadioButton GroupName="TagMode" Content="すべて含む" Margin="0,0,12,0"
                                             IsChecked="{Binding IsTagAny, Converter={StaticResource InverseBool}}" />
                                <RadioButton GroupName="TagMode" Content="どれかを含む" IsChecked="{Binding IsTagAny}"
                                             AutomationProperties.Name="どれかを含む" />
                            </WrapPanel>
                            <ui:TextBlock Text="チェック=含む/右クリック=除外。数字は今の結果の中の件数です。" Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>

                        <!-- 項目(左に常に表示するタググループ、決定ログ Q-14)。検索欄でグループの中のタグを絞り込める -->
                        <ItemsControl ItemsSource="{Binding ItemSections}" AutomationProperties.Name="項目">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Group.Name}" IsExpanded="True" Margin="0,0,0,8">
                                        <StackPanel>
                                            <ui:TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="検索" Icon="{ui:SymbolIcon Search24}"
                                                        Margin="0,0,0,6" AutomationProperties.Name="{Binding SearchName}" />
                                            <ui:TextBlock Text="タグはまだありません" Style="{StaticResource SecondaryText}" FontSize="12"
                                                          Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource PinnedTagFilterTemplate}"
                                                          AutomationProperties.Name="{Binding Group.Name}" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 項目にないタグ・タググループの検索(決定ログ Q-7)と未設定(Q-5) -->
                        <Expander Header="タグを検索" IsExpanded="True" Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBox Text="{Binding OtherTagSearch, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="タグ名・グループ名"
                                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,6" AutomationProperties.Name="タグを検索" />
                                <DockPanel Margin="0,1">
                                    <ui:TextBlock DockPanel.Dock="Right" Text="{Binding UntaggedCount, StringFormat={}{0:N0}}" Margin="8,0,0,0"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <CheckBox Content="未設定(タグなし)" IsChecked="{Binding UntaggedOnly}" AutomationProperties.Name="未設定(タグなし)"
                                              ToolTip="タグが 1 つも付いていない PDF だけにします" />
                                </DockPanel>
                                <ui:TextBlock Text="{Binding OtherTagHint}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,4" />
                                <ItemsControl ItemsSource="{Binding OtherTags}" ItemTemplate="{StaticResource TagFilterTemplate}" AutomationProperties.Name="絞り込みのタグ" />
                            </StackPanel>
                        </Expander>

                        <!-- 補助項目(決定ログ Q-6)。初めは閉じておく。入っている値から選ぶか、文字・範囲で指定する -->
                        <Expander Header="補助項目" Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBlock Text="補助項目はまだありません" Style="{StaticResource SecondaryText}"
                                              Visibility="{Binding HasFields, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding FieldFilters}" AutomationProperties.Name="絞り込みの補助項目">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <ui:TextBlock Text="{Binding Field.Name}" FontTypography="BodyStrong" Margin="0,0,0,4" />
                                                <StackPanel Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
                                                    <ui:TextBox Text="{Binding ValueSearch, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="値を検索(例:202610)"
                                                                Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,4" AutomationProperties.Name="{Binding ValueSearchName}" />
                                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding VisibleOptions}" ItemTemplate="{StaticResource OptionFilterTemplate}"
                                                                      AutomationProperties.Name="{Binding Field.Name, StringFormat={}{0}の値}" />
                                                    </ScrollViewer>
                                                </StackPanel>
                                                <ui:TextBlock Text="含む文字" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,2"
                                                              Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                                <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="含む文字"
                                                            AutomationProperties.Name="{Binding Field.Name}"
                                                            Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                                <ui:TextBlock Text="範囲で指定" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,2"
                                                              Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibility}}" />
                                                <Grid Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Grid.Column="0" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding RangeHint}"
                                                                AutomationProperties.Name="{Binding Field.Name, StringFormat={}{0}(から)}" />
                                                    <ui:TextBlock Grid.Column="1" Text="〜" VerticalAlignment="Center" Margin="4,0" />
                                                    <ui:TextBox Grid.Column="2" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding RangeHint}"
                                                                AutomationProperties.Name="{Binding Field.Name, StringFormat={}{0}(まで)}" />
                                                </Grid>
                                                <ui:TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- 評価・登録日・最終閲覧日(決定ログ L-4) -->
                        <Expander Header="評価" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{Binding RatingFilters}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRatingFilter}"
                                      AutomationProperties.Name="評価で絞り込み" />
                        </Expander>
                        <Expander Header="登録日" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding RegisteredFrom, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="2026-04-01"
                                                AutomationProperties.Name="登録日(から)" />
                                    <ui:TextBlock Grid.Column="1" Text="〜" VerticalAlignment="Center" Margin="4,0" />
                                    <ui:TextBox Grid.Column="2" Text="{Binding RegisteredTo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="2026-09-30"
                                                AutomationProperties.Name="登録日(まで)" />
                                </Grid>
                                <ui:TextBlock Text="{Binding RegisteredError}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="最終閲覧日" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid IsEnabled="{Binding NeverViewedOnly, Converter={StaticResource InverseBool}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding LastViewedFrom, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="2026-04-01"
                                                AutomationProperties.Name="最終閲覧日(から)" />
                                    <ui:TextBlock Grid.Column="1" Text="〜" VerticalAlignment="Center" Margin="4,0" />
                                    <ui:TextBox Grid.Column="2" Text="{Binding LastViewedTo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="2026-09-30"
                                                AutomationProperties.Name="最終閲覧日(まで)" />
                                </Grid>
                                <CheckBox Content="一度も開いていないもの" IsChecked="{Binding NeverViewedOnly}" Margin="0,6,0,0"
                                          AutomationProperties.Name="一度も開いていないもの" />
                                <ui:TextBlock Text="{Binding LastViewedError}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Expander>

                        <!-- 保存先(決定ログ S-6)。ふだんは使わないので折りたたんでおく -->
                        <Expander Header="保存先" Margin="0,0,0,8" Visibility="{Binding HasSubs, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox ItemsSource="{Binding StorageFilters}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStorageFilter}"
                                      AutomationProperties.Name="保存先で絞り込み" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- 中央:サムネイル一覧(決定ログ I-3、G-5) -->
            <Border Grid.Column="2" Style="{StaticResource PaneBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:InfoBar Grid.Row="0" Margin="4,0,4,8" IsClosable="True" Severity="Success"
                                Title="{Binding ListMessageTitle}" Message="{Binding ListMessage}" IsOpen="{Binding IsListMessageOpen, Mode=TwoWay}" />
                    <DockPanel Grid.Row="1" Margin="4,0,4,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSort}"
                                      MinWidth="140" AutomationProperties.Name="並び替え" />
                            <ui:Button Content="{Binding SortDirectionText}" Command="{Binding ToggleSortDirectionCommand}" Margin="6,0,12,0"
                                       Icon="{ui:SymbolIcon ArrowSort24}" ToolTip="昇順・降順を切り替えます" AutomationProperties.Name="並び順の向き" />
                            <ui:Button Icon="{ui:SymbolIcon Grid24}" Command="{Binding ShowListCommand}" CommandParameter="grid"
                                       ToolTip="サムネイルで表示" AutomationProperties.Name="サムネイル表示" Margin="0,0,4,0" />
                            <ui:Button Icon="{ui:SymbolIcon AppsList24}" Command="{Binding ShowListCommand}" CommandParameter="list"
                                       ToolTip="リストで表示" AutomationProperties.Name="リスト表示" />
                        </StackPanel>
                        <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong"
                                      Text="{Binding ResultText}" AutomationProperties.AutomationId="ResultCount" />
                    </DockPanel>

                    <DockPanel Grid.Row="2" Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}">
                        <!-- リスト表示の見出し(決定ログ L-9) -->
                        <Grid DockPanel.Dock="Top" Margin="12,0,24,4" Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="タイトル" Style="{StaticResource ListHeader}" />
                            <ui:TextBlock Grid.Column="1" Text="ファイル名" Style="{StaticResource ListHeader}" />
                            <ui:TextBlock Grid.Column="2" Text="タグ" Style="{StaticResource ListHeader}" />
                            <ui:TextBlock Grid.Column="3" Text="評価" Style="{StaticResource ListHeader}" />
                            <ui:TextBlock Grid.Column="4" Text="登録日" Style="{StaticResource ListHeader}" />
                            <ui:TextBlock Grid.Column="5" Text="閲覧" Style="{StaticResource ListHeader}" />
                            <ui:TextBlock Grid.Column="6" Text="最終閲覧日" Style="{StaticResource ListHeader}" />
                        </Grid>
                        <ListBox x:Name="DocumentList" ItemsSource="{Binding Results}" SelectionMode="Extended" SelectionChanged="OnDocumentSelectionChanged" MouseDoubleClick="OnDocumentDoubleClick" PreviewKeyDown="OnDocumentListKeyDown"
                                 Style="{StaticResource DocumentListStyle}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="PDF の一覧">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="OnListContextMenuOpened">
                                    <MenuItem Header="開く" Click="OnOpenClick" InputGestureText="Enter">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Open24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="並べて比較" Click="OnCompareSelectedClick">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="SplitVertical24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="版としてまとめる" Click="OnGroupVersionsClick">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Stack24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <!-- 決定ログ S-3: 移す先は開くたびに並べる -->
                                    <MenuItem x:Name="MoveMenu" Header="保存先を移す">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="FolderArrowRight24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="削除" Click="OnDeleteClick" InputGestureText="Delete">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>

                    <!-- 1 件も登録されていないとき -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasDocuments, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:TextBlock HorizontalAlignment="Center" Margin="0,12,0,4" FontTypography="Subtitle"
                                      Text="{Binding DocumentSummaryText}" />
                        <ui:TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryText}"
                                      Text="「取り込み」ボタン、またはファイルやフォルダのドラッグ&amp;ドロップで PDF を追加できます" />
                    </StackPanel>

                    <!-- 条件に合うものがないとき -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Search24" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:TextBlock HorizontalAlignment="Center" Margin="0,12,0,4" FontTypography="BodyStrong"
                                      Text="条件に合う PDF がありません" />
                        <ui:Button HorizontalAlignment="Center" Content="条件をクリア" Command="{Binding ClearConditionsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- 右:詳細の表示と編集(決定ログ G-5、J-1〜J-7) -->
            <Border Grid.Column="4" Style="{StaticResource PaneBorder}" Padding="0">
                <Grid>
                    <ui:TextBlock Text="一覧から PDF を選ぶと、ここに詳細が表示され、編集できます(Ctrl・Shift で複数選択)" Style="{StaticResource SecondaryText}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="16"
                                  Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <!-- 下部:保存・取り消し(決定ログ J-1) -->
                        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,10">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Left" Icon="{ui:SymbolIcon Delete24}" Click="OnDeleteClick" Margin="0,0,8,0"
                                           ToolTip="削除(Delete)" AutomationProperties.Name="削除" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Content="取り消し" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                                    <ui:Button Content="保存" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}"
                                               AutomationProperties.Name="保存" />
                                </StackPanel>
                                <ui:TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="SaveStatus">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Text" Value="{Binding SaveMessage}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                    <Setter Property="Text" Value="保存していない変更があります" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <StackPanel>
                                <!-- 決定ログ S-4: つながっていないサブの文書は表示のみ -->
                                <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,8" Title="表示のみ"
                                            Message="{Binding ReadOnlyMessage}" IsOpen="{Binding IsEditable, Converter={StaticResource InverseBool}, Mode=OneWay}" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="開く" Icon="{ui:SymbolIcon Open24}" Click="OnOpenClick"
                                               ToolTip="ビューアで開きます(ダブルクリック・Enter でも開けます)" AutomationProperties.Name="開く" />
                                    <ui:TextBlock Text="{Binding SelectionText}" FontTypography="BodyStrong" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <Border Height="220" CornerRadius="4" BorderThickness="1" Background="White" Margin="0,8,0,0"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Visibility="{Binding SelectedInfo, Converter={StaticResource NullToCollapsed}}">
                                    <Image Source="{Binding SelectedThumbnailPath, Converter={StaticResource Thumbnail}}" Stretch="Uniform" />
                                </Border>

                                <views:DocumentEditorView DataContext="{Binding Editor}" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}" />

                                <!-- 版の履歴(決定ログ N-1①・N-3・N-6・N-8) -->
                                <StackPanel Visibility="{Binding IsSingleSelection, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsEditable}">
                                    <DockPanel Margin="0,16,0,6">
                                        <ui:Button DockPanel.Dock="Right" Content="新しい版を追加" Icon="{ui:SymbolIcon DocumentAdd24}"
                                                   Click="OnAddVersionClick" AutomationProperties.Name="新しい版を追加" />
                                        <ui:TextBlock Text="版の履歴" FontTypography="BodyStrong" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ui:TextBlock Text="版はまだありません。「新しい版を追加」で改訂版を登録できます。" FontSize="12" TextWrapping="Wrap"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Visibility="{Binding HasVersions, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ui:TextBlock Text="{Binding OldVersionNote}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                                  Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                  Visibility="{Binding OldVersionNote, Converter={StaticResource NullToCollapsed}}" />
                                    <ItemsControl ItemsSource="{Binding Versions}" AutomationProperties.Name="版の履歴">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="6" BorderThickness="1"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Icon="{ui:SymbolIcon Open24}" Padding="6,4" Margin="0,0,4,0" ToolTip="開く"
                                                                       Tag="{Binding Info.DocumentId}" Click="OnOpenVersionClick"
                                                                       AutomationProperties.Name="{Binding Info.DisplayName, StringFormat={}{0}を開く}" />
                                                            <ui:Button Icon="{ui:SymbolIcon SplitVertical24}" Padding="6,4" Margin="0,0,4,0" ToolTip="今選んでいる版と並べて比較"
                                                                       Tag="{Binding Info.DocumentId}" Click="OnCompareVersionClick"
                                                                       AutomationProperties.Name="{Binding Info.DisplayName, StringFormat={}{0}と比較}" />
                                                            <ui:Button Icon="{ui:SymbolIcon CursorClick24}" Padding="6,4" Margin="0,0,4,0" ToolTip="この版を選択"
                                                                       Tag="{Binding Info.DocumentId}" Click="OnSelectVersionClick"
                                                                       AutomationProperties.Name="{Binding Info.DisplayName, StringFormat={}{0}を選択}" />
                                                            <ui:Button Icon="{ui:SymbolIcon LinkDismiss24}" Padding="6,4" ToolTip="版から外す"
                                                                       Tag="{Binding Info.DocumentId}" Click="OnDetachVersionClick"
                                                                       AutomationProperties.Name="{Binding Info.DisplayName, StringFormat={}{0}を版から外す}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <ui:TextBlock Text="{Binding Text}" FontTypography="BodyStrong" />
                                                            <ui:TextBlock Text="{Binding Sub}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel Margin="0,4,0,0" Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}">
                                        <ui:TextBlock DockPanel.Dock="Left" Text="この版の名前" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ui:TextBox Text="{Binding VersionLabel, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="任意(例:Rev.C)"
                                                    AutomationProperties.Name="この版の名前" />
                                    </DockPanel>
                                </StackPanel>

                                <!-- 続き・関連(決定ログ V-1・V-2) -->
                                <StackPanel Visibility="{Binding IsSingleSelection, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsEditable}">
                                    <DockPanel Margin="0,16,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:Button Content="前をつなぐ" Padding="8,4" Margin="0,0,4,0" Click="OnLinkPreviousClick" AutomationProperties.Name="前をつなぐ"
                                                       ToolTip="この PDF の前(前編など)になる PDF を選びます" />
                                            <ui:Button Content="次をつなぐ" Padding="8,4" Click="OnLinkNextClick" AutomationProperties.Name="次をつなぐ"
                                                       ToolTip="この PDF の次(後編など)になる PDF を選びます" />
                                        </StackPanel>
                                        <ui:TextBlock Text="続き" FontTypography="BodyStrong" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ui:TextBlock Text="続きはありません。前編・後編などは「前をつなぐ」「次をつなぐ」でつなげます。" FontSize="12" TextWrapping="Wrap"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Visibility="{Binding HasChain, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding ChainRows}" ItemTemplate="{StaticResource ChainRowTemplate}" AutomationProperties.Name="続き" />

                                    <DockPanel Margin="0,16,0,6">
                                        <ui:Button DockPanel.Dock="Right" Content="関連を追加" Icon="{ui:SymbolIcon Link24}" Padding="8,4" Click="OnAddRelatedClick"
                                                   AutomationProperties.Name="関連を追加" ToolTip="この PDF に関連する PDF を選びます(順番なし)" />
                                        <ui:TextBlock Text="関連" FontTypography="BodyStrong" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ui:TextBlock Text="関連する PDF はありません。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Visibility="{Binding HasRelated, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding RelatedRows}" ItemTemplate="{StaticResource RelatedRowTemplate}" AutomationProperties.Name="関連" />
                                </StackPanel>

                                <!-- 編集できない情報(決定ログ J-7) -->
                                <StackPanel DataContext="{Binding SelectedInfo}"
                                            Visibility="{Binding DataContext.SelectedInfo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToCollapsed}}">
                                    <ui:TextBlock Text="情報" FontTypography="BodyStrong" Margin="0,16,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ui:TextBlock Grid.Row="6" Text="保存先" Style="{StaticResource InfoLabel}" />
                                        <ui:TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Storage}" TextWrapping="Wrap" AutomationProperties.AutomationId="StorageInfo" />
                                        <ui:TextBlock Grid.Row="0" Text="元のファイル名" Style="{StaticResource InfoLabel}" />
                                        <ui:TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OriginalFileName}" TextWrapping="Wrap" />
                                        <ui:TextBlock Grid.Row="1" Text="ページ数" Style="{StaticResource InfoLabel}" />
                                        <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PageCount}" />
                                        <ui:TextBlock Grid.Row="2" Text="ファイルサイズ" Style="{StaticResource InfoLabel}" />
                                        <ui:TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileSize}" />
                                        <ui:TextBlock Grid.Row="3" Text="登録日時" Style="{StaticResource InfoLabel}" />
                                        <ui:TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Registered}" />
                                        <ui:TextBlock Grid.Row="4" Text="閲覧回数" Style="{StaticResource InfoLabel}" />
                                        <ui:TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ViewCount}" />
                                        <ui:TextBlock Grid.Row="5" Text="最終閲覧日" Style="{StaticResource InfoLabel}" />
                                        <ui:TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastViewed}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
