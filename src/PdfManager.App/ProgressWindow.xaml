<ui:FluentWindow x:Class="PdfManager.App.ProgressWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="処理中"
                 Width="480" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar x:Name="TitleBarControl" Title="処理中" ShowMinimize="False" ShowMaximize="False" ShowClose="False" />
        <StackPanel Margin="24,8,24,24">
            <ui:TextBlock x:Name="CountText" Text="準備しています…" FontTypography="BodyStrong" AutomationProperties.AutomationId="ProgressCount" />
            <ui:TextBlock x:Name="ItemText" Text=" " TextTrimming="CharacterEllipsis" Margin="0,4,0,12"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="1" />
            <ui:Button x:Name="CancelButton" Content="中止" HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
