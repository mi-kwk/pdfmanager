<ui:FluentWindow x:Class="PdfManager.App.ArchiveWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:PdfManager.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ArchiveViewModel}"
                 Title="退避"
                 Width="1040" Height="820" MinWidth="820" MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <Style x:Key="Hint" TargetType="ui:TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <DataTemplate x:Key="RowTemplate">
            <DockPanel Margin="0,2">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Title}" />
                <ui:TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Width="80" TextAlignment="Right" VerticalAlignment="Center" />
                <ui:TextBlock DockPanel.Dock="Right" Text="{Binding RatingText}" Width="70" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <ui:TextBlock Text="{Binding LastUsedText}" Style="{StaticResource Hint}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <!-- SC-23 退避(決定ログ EA-1〜EA-8) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="退避" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,0,16,8">
            <ui:TextBlock Text="{Binding SpaceText}" FontTypography="BodyStrong" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                          Text="長く開いていない PDF を、外付け HDD などのサブライブラリへまとめて移します。移したあとも一覧・検索には出ます(開くときだけ HDD が必要です)。" />
            <!-- 決定ログ EA-4: 移す先 -->
            <DockPanel>
                <ui:TextBlock Text="移す先" VerticalAlignment="Center" Width="70" />
                <ComboBox ItemsSource="{Binding Targets}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTarget}" AutomationProperties.Name="移す先" />
            </DockPanel>
            <ui:TextBlock Text="{Binding TargetNote}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="70,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="2" Margin="16,0,16,0">
            <!-- 決定ログ EA-2・EA-3: 退避の候補 -->
            <TabItem Header="退避の候補">
                <DockPanel Margin="0,8,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ui:TextBlock Text="最後に開いた日(開いたことがなければ登録日)から" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ui:TextBox Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}" Width="64" AutomationProperties.Name="月数" />
                        <ui:TextBlock Text="か月以上" VerticalAlignment="Center" Margin="6,0,16,0" />
                        <ui:TextBlock Text="第 1 グループのタグ" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding TagChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTag}" MinWidth="160"
                                  AutomationProperties.Name="退避の候補のタグ" Margin="0,0,16,0" />
                        <ui:TextBlock Text="登録日" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding RegisteredFrom}" Width="150" AutomationProperties.Name="登録日の始め" />
                        <ui:TextBlock Text="〜" VerticalAlignment="Center" Margin="4,0" />
                        <DatePicker SelectedDate="{Binding RegisteredTo}" Width="150" AutomationProperties.Name="登録日の終わり" />
                    </WrapPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="選んだものを移す" Appearance="Primary" Icon="{ui:SymbolIcon ArchiveArrowBack24}"
                                   Click="OnArchiveClick" AutomationProperties.Name="選んだものを移す" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="すべて選ぶ" Icon="{ui:SymbolIcon CheckboxChecked24}" Command="{Binding CheckAllCandidatesCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="すべて外す" Icon="{ui:SymbolIcon CheckboxUnchecked24}" Command="{Binding UncheckAllCandidatesCommand}" Margin="0,0,12,0" />
                            <ui:TextBlock Text="{Binding CandidateSummary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <ui:TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                  Text="評価が ★4 以上のものは、初めはチェックを外しています。版のまとまりは、まとめて移します。" />
                    <ListBox ItemsSource="{Binding Candidates}" ItemTemplate="{StaticResource RowTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="退避の候補" />
                </DockPanel>
            </TabItem>
            <!-- 決定ログ EA-8: 呼び戻し -->
            <TabItem Header="メインへ戻す候補">
                <DockPanel Margin="0,8,0,0">
                    <ui:TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                  Text="サブにあるのに、最近 90 日によく開いている PDF です。メインへ戻すと、HDD をつながなくても開けます。" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="選んだものをメインへ戻す" Appearance="Primary" Icon="{ui:SymbolIcon ArrowUndo24}"
                                   Click="OnRestoreClick" AutomationProperties.Name="選んだものをメインへ戻す" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="すべて選ぶ" Icon="{ui:SymbolIcon CheckboxChecked24}" Command="{Binding CheckAllFrequentCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="すべて外す" Icon="{ui:SymbolIcon CheckboxUnchecked24}" Command="{Binding UncheckAllFrequentCommand}" Margin="0,0,12,0" />
                            <ui:TextBlock Text="{Binding FrequentSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Frequent}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="メインへ戻す候補">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Title}" />
                                    <ui:TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Width="80" TextAlignment="Right" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <ui:TextBlock Text="{Binding RecentViewsText}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,16">
            <ui:Button Content="閉じる" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
