<ui:FluentWindow x:Class="PdfManager.App.TitleBatchWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:PdfManager.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:TitleBatchViewModel}"
                 Title="タイトルの付け直し"
                 Width="900" Height="820" MinWidth="680" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <!-- SC-18 タイトルの付け直し(選ぶ画面、決定ログ DI-1・DI-2・DJ-1〜DJ-3) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="タイトルの付け直し" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,0,16,8">
            <DockPanel Margin="0,0,0,8">
                <ui:TextBlock Text="第 1 グループのタグ(必須)" VerticalAlignment="Center" Margin="0,0,8,0" Width="170" />
                <ComboBox ItemsSource="{Binding TagChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTag}"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Label" AutomationProperties.Name="第 1 グループのタグ" />
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <ui:TextBlock Text="絞り込み" VerticalAlignment="Center" Margin="0,0,8,0" Width="170" />
                <!-- 決定ログ DJ-2: 「〇〇＋番号だけ」 -->
                <CheckBox DockPanel.Dock="Right" Content="＋番号だけ" IsChecked="{Binding NumberOnly}" Margin="12,0,0,0"
                          AutomationProperties.Name="＋番号だけ" ToolTip="入れた名前の後ろが番号だけのタイトル(番号なしも含む)に絞ります" />
                <ui:TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="タイトルの一部(例:とんこつらーめん)"
                            Icon="{ui:SymbolIcon Filter24}" AutomationProperties.Name="タイトルの絞り込み" />
            </DockPanel>
            <StackPanel Orientation="Horizontal">
                <ui:TextBlock Text="表示" VerticalAlignment="Center" Margin="0,0,8,0" Width="170" />
                <RadioButton Content="シリーズでまとめる" IsChecked="{Binding GroupBySeries}" GroupName="View" Margin="0,0,16,0" />
                <RadioButton Content="一覧" GroupName="View" x:Name="ListRadio" />
            </StackPanel>
            <ui:TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Margin="16,0,16,0" Padding="8" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}" AutomationProperties.Name="付け直す PDF">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,6" Padding="8,4">
                                <Expander.Header>
                                    <!-- 決定ログ DJ-1: シリーズのチェックでまとめて選ぶ -->
                                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Header}" AutomationProperties.Name="{Binding Header}" FontWeight="SemiBold" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="24,2,0,2">
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center"
                                                          MinWidth="0" Margin="0,0,8,0" Click="OnRowClick" AutomationProperties.Name="{Binding Title}" />
                                                <Border DockPanel.Dock="Left" Width="44" Height="58" Margin="0,0,10,0" CornerRadius="3" BorderThickness="1"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="White">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <ui:TextBlock Text="{Binding Note}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="3" Margin="16,12,16,16">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button Content="すべて選ぶ" Icon="{ui:SymbolIcon CheckboxChecked24}" Command="{Binding CheckAllCommand}" Margin="0,0,8,0"
                           ToolTip="表示しているものをすべて選びます" />
                <ui:Button Content="すべて外す" Icon="{ui:SymbolIcon CheckboxUnchecked24}" Command="{Binding UncheckAllCommand}" Margin="0,0,12,0" />
                <ui:TextBlock Text="{Binding CheckedText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="閉じる" Click="OnCloseClick" Margin="0,0,8,0" />
                <ui:Button Content="次へ(付け直す)" Appearance="Primary" Icon="{ui:SymbolIcon ArrowRight24}" Click="OnNextClick"
                           AutomationProperties.Name="次へ(付け直す)" />
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
