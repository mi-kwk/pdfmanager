<ui:FluentWindow x:Class="PdfManager.App.DuplicateResultWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="1 ページ目が同じ PDF"
                 Width="1000" Height="680" MinWidth="760" MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <!-- 決定ログ DH-4: 取り込み中の PDF と、1 ページ目が似ている登録済みの PDF を並べて見せる -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="1 ページ目が同じ PDF" ShowMinimize="False" ShowMaximize="False" />
        <ui:TextBlock x:Name="MessageText" Grid.Row="1" Margin="24,0,24,12" TextWrapping="Wrap" />
        <Grid Grid.Row="2" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <ui:TextBlock x:Name="NewName" DockPanel.Dock="Top" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="White" CornerRadius="4">
                    <Image x:Name="NewImage" Stretch="Uniform" Margin="4" />
                </Border>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <ui:TextBlock DockPanel.Dock="Top" Text="1 ページ目が似ている登録済みの PDF" FontTypography="BodyStrong" Margin="0,0,0,6" />
                <ListBox x:Name="MatchList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="似ている登録済みの PDF">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <Border DockPanel.Dock="Left" Width="150" Height="200" Margin="0,0,12,0" BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="White" CornerRadius="3">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" TextWrapping="Wrap" />
                                    <ui:TextBlock Text="{Binding FileName}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBlock Text="{Binding CreatedText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBlock Text="{Binding SimilarityText}" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,24">
            <ui:Button x:Name="HoldButton" Content="保留へ" Icon="{ui:SymbolIcon Clock24}" Click="OnHoldClick" Margin="0,0,8,0" />
            <ui:Button Content="削除予定へ" Icon="{ui:SymbolIcon Delete24}" Click="OnDeleteClick" Margin="0,0,24,0" />
            <ui:Button Content="そのまま続ける" Appearance="Primary" IsCancel="True" Click="OnContinueClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
