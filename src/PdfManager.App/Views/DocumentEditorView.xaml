<UserControl x:Class="PdfManager.App.Views.DocumentEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PdfManager.App.ViewModels"
             xmlns:conv="clr-namespace:PdfManager.App.Converters"
             xmlns:views="clr-namespace:PdfManager.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DocumentEditor}">

    <!-- 取り込み画面と詳細エリアで共通の入力欄(DataContext は DocumentEditor) -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="SectionTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- 決定ログ GA-1・GA-3: 見た目は文字のまま、選んでコピーできる(Ctrl+C・右クリックの「コピー」) -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Warning" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <StackPanel IsEnabled="{Binding HasTargets}">
        <ui:TextBlock Text="タイトル" Style="{StaticResource SectionTitle}" />
        <!-- 決定ログ DF-1〜DF-3: 入力するたびに、登録済みのタイトル(第 1 グループのタグが同じものを先)と、この PDF のファイル名・文字を候補に出す。
             ↑↓ で選んで Enter で入れる。▼ は入力に関係なくすべての候補 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 決定ログ GA-2: タイトル全体をコピー -->
            <ui:Button Grid.Column="2" Margin="4,0,0,0" Padding="8,6" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyTitleClick"
                       AutomationProperties.Name="タイトルをコピー" ToolTip="タイトルをコピー" />
            <ui:TextBox x:Name="TitleBox" Grid.Column="0" Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="タイトル"
                        PreviewKeyDown="OnTitleKeyDown" LostKeyboardFocus="OnTitleLostFocus" />
            <ui:Button Grid.Column="1" Margin="4,0,0,0" Padding="8,6" Icon="{ui:SymbolIcon ChevronDown24}" Click="OnShowAllTitlesClick"
                       AutomationProperties.Name="タイトルの候補" ToolTip="タイトルの候補(登録済みのタイトル、ファイル名など)"
                       Visibility="{Binding UseTitleSuggestions, Converter={StaticResource BoolToVisibility}}" />
            <Popup x:Name="TitlePopup" Grid.Column="0" PlacementTarget="{Binding ElementName=TitleBox}" Placement="Bottom" StaysOpen="False"
                   IsOpen="{Binding IsTitleSuggestionsOpen}" AllowsTransparency="True">
                <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="{Binding ActualWidth, ElementName=TitleBox}" MaxHeight="360">
                    <ListBox x:Name="TitleSuggestionList" ItemsSource="{Binding TitleSuggestions}" AutomationProperties.Name="タイトルの候補の一覧"
                             PreviewMouseLeftButtonUp="OnTitleSuggestionClick" Focusable="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,1">
                                    <ui:TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                    <ui:TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
        <!-- 決定ログ DG-1: 登録済みのタイトルと重なったら、次の番号を案内する -->
        <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TitleDuplicateText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="この番号にする" Command="{Binding UseNextTitleCommand}" Margin="8,0,0,0"
                           VerticalAlignment="Center" AutomationProperties.Name="この番号にする" />
                <ui:TextBlock Text="{Binding TitleDuplicateText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ui:TextBlock Text="(複数の値)入力すると、選択中の全件が同じタイトルになります" Style="{StaticResource Hint}"
                      Visibility="{Binding IsTitleMixed, Converter={StaticResource BoolToVisibility}}" />
        <ui:TextBlock Text="空のまま保存・登録すると「未入力」になります。" Style="{StaticResource Hint}" Margin="0,4,0,0" />

        <ui:TextBlock Text="ファイル名" Style="{StaticResource SectionTitle}" />
        <CheckBox Content="タイトルと同じにする" IsChecked="{Binding EditorUseTitle}" Margin="0,0,0,8"
                  AutomationProperties.Name="タイトルと同じにする" />
        <Grid IsEnabled="{Binding IsFileNamePartsEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding PrefixOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding EditorPrefix}" AutomationProperties.Name="ファイル名の先頭" />
            <ui:TextBlock Grid.Column="1" Text="+" VerticalAlignment="Center" Margin="8,0" />
            <ui:TextBox Grid.Column="2" Text="{Binding EditorSuffix, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{Binding SuffixPlaceholder}" AutomationProperties.Name="ファイル名の自由入力" />
        </Grid>
        <TextBox Text="{Binding FileNamePreview, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,6,0,0"
                 AutomationProperties.Name="ファイル名のプレビュー" />
        <ui:TextBlock Text="{Binding FileNameWarning}" Style="{StaticResource Warning}" />
        <ui:Button Content="タグから作り直す" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,6,0,0"
                   Command="{Binding RebuildFileNameCommand}"
                   Visibility="{Binding CanRebuildFileName, Converter={StaticResource BoolToVisibility}}" />

        <!-- 評価・メモ(詳細エリアのみ、決定ログ J-5・J-6) -->
        <StackPanel Visibility="{Binding ShowRatingAndMemo, Converter={StaticResource BoolToVisibility}}">
            <ui:TextBlock Text="評価" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Stars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Command="{Binding ClickCommand}" Appearance="Transparent" Padding="4" BorderThickness="0"
                                       AutomationProperties.Name="{Binding Value, StringFormat=★{0}}">
                                <ui:SymbolIcon Symbol="Star24" FontSize="22" Filled="{Binding IsFilled}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                                    <Setter Property="Foreground" Value="#F5A623" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:TextBlock Text="(複数の値)" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"
                              Visibility="{Binding IsRatingMixed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ui:TextBlock Text="同じ星をもう一度押すと未評価に戻ります。" Style="{StaticResource Hint}" />
        </StackPanel>

        <!-- 補助項目(年月・日付・数値・文字、決定ログ Q-6) -->
        <ui:TextBlock Text="補助項目" Style="{StaticResource SectionTitle}" />
        <ui:TextBlock Text="補助項目がありません(年月などを入れたいときは、メイン画面の「項目・タグ」で作れます)。">
            <ui:TextBlock.Style>
                <Style TargetType="ui:TextBlock" BasedOn="{StaticResource Hint}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FieldEditors.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:TextBlock.Style>
        </ui:TextBlock>
        <ItemsControl ItemsSource="{Binding FieldEditors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{Binding Field.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ui:TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding Field.Name}"
                                    Visibility="{Binding IsSelect, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Text}"
                                  AutomationProperties.Name="{Binding Field.Name}"
                                  Visibility="{Binding IsSelect, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="(複数の値)選ぶと、選択中の全件が同じ値になります" Style="{StaticResource Hint}"
                                      Visibility="{Binding IsMixed, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Error}" Style="{StaticResource Warning}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:TextBlock Text="タグ" Style="{StaticResource SectionTitle}" />
        <!-- 取り込み画面:タググループごとの欄でその場で選ぶ(決定ログ R-11 ②) -->
        <views:TagSectionsView Visibility="{Binding ShowTagSections, Converter={StaticResource BoolToVisibility}}" />
        <!-- 詳細エリア:付いているタグだけを表示し、「タグ設定」で別画面を開く(決定ログ R-11 ④) -->
        <StackPanel Visibility="{Binding ShowTagSections, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding AssignedTags}" AutomationProperties.Name="付いているタグ">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="{Binding GroupName}" TextTrimming="CharacterEllipsis"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding TagsText, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                     AutomationProperties.Name="{Binding GroupName, StringFormat={}{0}のタグ}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:TextBlock Text="未設定(タグは付いていません)" Style="{StaticResource Hint}"
                          Visibility="{Binding HasAssignedTags, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Button Content="タグ設定" Icon="{ui:SymbolIcon Tag24}" Margin="0,8,0,0" Command="{Binding OpenTagSettingCommand}"
                       AutomationProperties.Name="タグ設定" ToolTip="タグを付ける・外す画面を開きます" />
        </StackPanel>

        <!-- メモ(詳細エリアのみ) -->
        <StackPanel Visibility="{Binding ShowRatingAndMemo, Converter={StaticResource BoolToVisibility}}">
            <ui:TextBlock Text="メモ" Style="{StaticResource SectionTitle}" />
            <ui:TextBox Text="{Binding EditorMemo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding MemoPlaceholder}"
                        AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top"
                        AutomationProperties.Name="メモ" />
        </StackPanel>
    </StackPanel>
</UserControl>
