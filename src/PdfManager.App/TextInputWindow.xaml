<ui:FluentWindow x:Class="PdfManager.App.TextInputWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="入力"
                 Width="460" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar x:Name="TitleBarControl" Title="入力" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,8,24,24">
            <ui:TextBlock x:Name="LabelText" FontTypography="BodyStrong" Margin="0,0,0,8" />
            <ui:TextBox x:Name="InputBox" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <ui:Button Content="キャンセル" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" />
                <ui:Button Content="OK" Appearance="Primary" IsDefault="True" Click="OnOkClick" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
