<ui:FluentWindow x:Class="PdfManager.App.TagBulkWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:PdfManager.App.ViewModels"
                 xmlns:views="clr-namespace:PdfManager.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:TagBulkViewModel}"
                 Title="タグの一括付与"
                 Width="1360" Height="860" MinWidth="1040" MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </ui:FluentWindow.Resources>

    <!-- SC-21 タグの一括付与(決定ログ DM-1〜DM-5) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="タグの一括付与" ShowMinimize="False" />

        <!-- 決定ログ DM-2: 対象の絞り込み(タイトルの付け直しの選ぶ画面と同じ) -->
        <StackPanel Grid.Row="1" Margin="16,0,16,8" DataContext="{Binding Selector}">
            <DockPanel Margin="0,0,0,8">
                <ui:TextBlock Text="対象" VerticalAlignment="Center" Margin="0,0,8,0" Width="90" />
                <CheckBox DockPanel.Dock="Right" Content="＋番号だけ" IsChecked="{Binding NumberOnly}" Margin="12,0,0,0" AutomationProperties.Name="＋番号だけ" />
                <ui:TextBox DockPanel.Dock="Right" Width="320" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="タイトルの一部"
                            Icon="{ui:SymbolIcon Filter24}" AutomationProperties.Name="タイトルの絞り込み" Margin="12,0,0,0" />
                <ComboBox ItemsSource="{Binding TagChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTag}"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Label" AutomationProperties.Name="対象の PDF" />
            </DockPanel>
            <StackPanel Orientation="Horizontal">
                <ui:TextBlock Text="表示" VerticalAlignment="Center" Margin="0,0,8,0" Width="90" />
                <RadioButton Content="シリーズでまとめる" IsChecked="{Binding GroupBySeries}" GroupName="BulkView" Margin="0,0,16,0" />
                <RadioButton Content="一覧" GroupName="BulkView" x:Name="ListRadio" />
                <ui:TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" Margin="24,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="360" MinWidth="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="400" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左:対象の PDF(チェックしたものが対象。行を押すと真ん中に大きく表示) -->
            <Border Grid.Column="0" Style="{StaticResource PaneBorder}" DataContext="{Binding Selector}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="すべて選ぶ" Icon="{ui:SymbolIcon CheckboxChecked24}" Command="{Binding CheckAllCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="すべて外す" Icon="{ui:SymbolIcon CheckboxUnchecked24}" Command="{Binding UncheckAllCommand}" Margin="0,0,12,0" />
                        <ui:TextBlock Text="{Binding CheckedText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}" AutomationProperties.Name="対象の PDF の一覧">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,6" Padding="8,4">
                                        <Expander.Header>
                                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Header}" AutomationProperties.Name="{Binding Header}" FontWeight="SemiBold" />
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="16,2,0,2" Background="Transparent" MouseLeftButtonUp="OnRowMouseUp" Cursor="Hand">
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center"
                                                                  MinWidth="0" Margin="0,0,8,0" Click="OnRowClick" AutomationProperties.Name="{Binding Title}" />
                                                        <Border DockPanel.Dock="Left" Width="40" Height="52" Margin="0,0,10,0" CornerRadius="3" BorderThickness="1"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="White">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <ui:TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                            <ui:TextBlock Text="{Binding Note}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 真ん中:押した PDF の 1 ページ目 -->
            <Border Grid.Column="2" Style="{StaticResource PaneBorder}">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Top" Text="{Binding PreviewTitle}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" Margin="4,0,4,8" />
                    <Image Source="{Binding Preview}" Stretch="Uniform" />
                </DockPanel>
            </Border>

            <!-- 右:タグの欄(決定ログ DM-3。チェック = 全件に付ける、外す = 全件から外す、一部 = そのまま) -->
            <Border Grid.Column="4" Style="{StaticResource PaneBorder}" Padding="0">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Top" Margin="12,10,12,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="チェックを付けたタグは選んだ全件に付け、外したタグは全件から外します。薄い表示(一部に付いている)のタグはそのままです。" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,4">
                        <views:TagSectionsView DataContext="{Binding Editor}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="16,12,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <ui:Button Content="閉じる" Click="OnCloseClick" Margin="0,0,8,0" />
                <ui:Button Content="実行" Appearance="Primary" Icon="{ui:SymbolIcon TagMultiple24}" Command="{Binding ApplyCommand}" AutomationProperties.Name="実行" />
            </StackPanel>
            <StackPanel>
                <ui:TextBlock Text="{Binding ChangesText}" TextWrapping="Wrap" FontTypography="BodyStrong" />
                <ui:TextBlock Text="{Binding ResultText}" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
