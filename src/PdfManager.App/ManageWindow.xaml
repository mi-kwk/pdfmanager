<ui:FluentWindow x:Class="PdfManager.App.ManageWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:PdfManager.App.ViewModels"
                 xmlns:conv="clr-namespace:PdfManager.App.Converters"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ManageViewModel}"
                 Title="項目・タグ管理"
                 Width="980" Height="680" MinWidth="820" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="TagItem">
            <StackPanel Margin="0,2">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Right" Text="{Binding UsageCount, StringFormat={}{0:N0} 件}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" />
                    <ui:TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ui:TextBlock Text="{Binding AttributeText}" FontSize="12" TextTrimming="CharacterEllipsis"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <ui:TextBlock.Style>
                        <Style TargetType="ui:TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AttributeText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:TextBlock.Style>
                </ui:TextBlock>
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="項目・タグ管理" ShowMinimize="False" ShowMaximize="False" />

        <TabControl Grid.Row="1" Margin="16,0,16,16">

            <!-- ===== 項目 ===== -->
            <TabItem Header="項目">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PaneBorder}">
                        <DockPanel>
                            <ui:TextBlock DockPanel.Dock="Top" Text="項目の一覧" Style="{StaticResource SectionTitle}" />

                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ui:Button Content="上へ" Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveFieldUpCommand}"
                                               IsEnabled="{Binding IsFieldSelected}" Margin="0,0,8,0" />
                                    <ui:Button Content="下へ" Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding MoveFieldDownCommand}"
                                               IsEnabled="{Binding IsFieldSelected}" Margin="0,0,8,0" />
                                    <ui:Button Content="削除" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteFieldCommand}"
                                               IsEnabled="{Binding IsFieldSelected}" />
                                </StackPanel>
                                <ui:TextBlock Text="項目を追加" Style="{StaticResource SectionTitle}" />
                                <ui:TextBox AutomationProperties.Name="新しい項目名" PlaceholderText="項目名(例:店舗、年月、メーカー)" Margin="0,0,0,8"
                                            Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="追加" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                                               Command="{Binding AddFieldCommand}" AutomationProperties.Name="項目を追加" Margin="8,0,0,0" />
                                    <ComboBox ItemsSource="{Binding FieldTypeChoices}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding NewFieldType}" AutomationProperties.Name="新しい項目の型" />
                                </DockPanel>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <ui:TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,0,0">
                                                <Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UsageCount, Mode=OneWay, StringFormat={}{0:N0} 件}" />
                                            </ui:TextBlock>
                                            <ui:TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PaneBorder}">
                        <Grid>
                            <ui:TextBlock Text="左の一覧から項目を選ぶと、ここで編集できます" Style="{StaticResource Hint}" Visibility="{Binding IsFieldSelected, Converter={StaticResource InverseBoolToVisibility}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

                            <DockPanel Visibility="{Binding IsFieldSelected, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel DockPanel.Dock="Top">
                                    <ui:TextBlock Text="名前" Style="{StaticResource SectionTitle}" />
                                    <DockPanel Margin="0,0,0,16">
                                        <ui:Button DockPanel.Dock="Right" Content="名前を変更" Command="{Binding RenameFieldCommand}" AutomationProperties.Name="項目名を変更" Margin="8,0,0,0" />
                                        <ui:TextBox AutomationProperties.Name="項目名" Text="{Binding EditFieldName, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>

                                    <ui:TextBlock Text="型" Style="{StaticResource SectionTitle}" />
                                    <DockPanel Margin="0,0,0,4">
                                        <ui:Button DockPanel.Dock="Right" Content="型を変更" Command="{Binding ChangeFieldTypeCommand}"
                                                   IsEnabled="{Binding CanChangeFieldType}" Margin="8,0,0,0" />
                                        <ComboBox ItemsSource="{Binding FieldTypeChoices}" DisplayMemberPath="Label"
                                                  SelectedItem="{Binding EditFieldType}" IsEnabled="{Binding CanChangeFieldType}" />
                                    </DockPanel>
                                    <ui:TextBlock Text="値が入っている文書がある項目は、型を変更できません。" Style="{StaticResource Hint}" Margin="0,0,0,16" />
                                </StackPanel>

                                <DockPanel Visibility="{Binding IsSelectField, Converter={StaticResource BoolToVisibility}}">
                                    <ui:TextBlock DockPanel.Dock="Top" Text="選択肢" Style="{StaticResource SectionTitle}" />
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <DockPanel Margin="0,0,0,8" IsEnabled="{Binding IsOptionSelected}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                <ui:Button Content="名前を変更" Command="{Binding RenameOptionCommand}" AutomationProperties.Name="選択肢名を変更" Margin="0,0,8,0" />
                                                <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveOptionUpCommand}" ToolTip="上へ" Margin="0,0,8,0" />
                                                <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding MoveOptionDownCommand}" ToolTip="下へ" Margin="0,0,8,0" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteOptionCommand}" ToolTip="削除" />
                                            </StackPanel>
                                            <ui:TextBox AutomationProperties.Name="選択中の選択肢" PlaceholderText="選択中の選択肢" Text="{Binding EditOptionValue, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Right" Content="追加" Icon="{ui:SymbolIcon Add24}"
                                                       Command="{Binding AddOptionCommand}" AutomationProperties.Name="選択肢を追加" Margin="8,0,0,0" />
                                            <ui:TextBox AutomationProperties.Name="新しい選択肢" PlaceholderText="新しい選択肢" Text="{Binding NewOptionValue, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding SelectedField.Options}" SelectedItem="{Binding SelectedOption}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <ui:TextBlock DockPanel.Dock="Right" Text="{Binding UsageCount, StringFormat={}{0:N0} 件}"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" />
                                                    <ui:TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== 自由タグ ===== -->
            <TabItem Header="自由タグ">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PaneBorder}">
                        <DockPanel>
                            <ui:TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                          Text="{Binding TagCount, StringFormat=タグの一覧({0:N0} 件)}" />
                            <ui:TextBox DockPanel.Dock="Top" AutomationProperties.Name="タグの絞り込み" PlaceholderText="絞り込み" Icon="{ui:SymbolIcon Filter24}" Margin="0,0,0,8"
                                        Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <ui:TextBlock Text="タグを追加" Style="{StaticResource SectionTitle}" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="追加" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                                               Command="{Binding AddTagCommand}" AutomationProperties.Name="タグを追加" Margin="8,0,0,0" />
                                    <ui:TextBox AutomationProperties.Name="新しいタグ名" PlaceholderText="タグ名" Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <ui:TextBlock Text="タグは取り込み時に入力しても自動で追加されます。" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding VisibleTags}" SelectedItem="{Binding SelectedTag}"
                                     ItemTemplate="{StaticResource TagItem}" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PaneBorder}">
                        <Grid>
                            <ui:TextBlock Text="左の一覧からタグを選ぶと、名前の変更・属性の設定・統合・削除ができます" Style="{StaticResource Hint}" Visibility="{Binding IsTagSelected, Converter={StaticResource InverseBoolToVisibility}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

                            <ScrollViewer Visibility="{Binding IsTagSelected, Converter={StaticResource BoolToVisibility}}"
                                          VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ui:TextBlock Text="名前" Style="{StaticResource SectionTitle}" />
                                <DockPanel Margin="0,0,0,4">
                                    <ui:Button DockPanel.Dock="Right" Content="名前を変更" Command="{Binding RenameTagCommand}" AutomationProperties.Name="タグ名を変更" Margin="8,0,0,0" />
                                    <ui:TextBox AutomationProperties.Name="タグ名" Text="{Binding EditTagName, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <ui:TextBlock Text="全角・半角、大文字・小文字の違いは同じタグとして扱います。" Style="{StaticResource Hint}" Margin="0,0,0,20" />

                                <ui:TextBlock Text="属性" Style="{StaticResource SectionTitle}" />
                                <ui:TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                              Text="取り込み画面で同じ選択肢を選ぶと、このタグが候補に出ます。チェックはすぐに保存されます。" />
                                <ui:TextBlock Style="{StaticResource Hint}" Margin="0,0,0,20"
                                              Visibility="{Binding HasAttributeFields, Converter={StaticResource InverseBoolToVisibility}}"
                                              Text="属性に使える項目がありません。「項目」タブで、型が「選択肢」の項目(例:エリア)を作ってください。" />
                                <ItemsControl ItemsSource="{Binding AttributeGroups}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <ui:TextBlock Text="{Binding FieldName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Choices}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked}" Margin="0,0,16,4" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ui:TextBlock Text="別のタグに統合" Style="{StaticResource SectionTitle}" />
                                <DockPanel Margin="0,0,0,4">
                                    <ui:Button DockPanel.Dock="Right" Content="統合" Command="{Binding MergeTagCommand}" Margin="8,0,0,0" />
                                    <ComboBox ItemsSource="{Binding MergeTargets}" SelectedItem="{Binding MergeTarget}" AutomationProperties.Name="統合先" DisplayMemberPath="Name"
                                              IsEditable="False" />
                                </DockPanel>
                                <ui:TextBlock Text="表記ゆれ(例:「そば屋」と「蕎麦屋」)を 1 つにまとめます。このタグが付いた文書には統合先のタグが付きます。"
                                              Style="{StaticResource Hint}" Margin="0,0,0,20" />

                                <ui:TextBlock Text="削除" Style="{StaticResource SectionTitle}" />
                                <ui:Button Content="このタグを削除" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteTagCommand}" />
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
